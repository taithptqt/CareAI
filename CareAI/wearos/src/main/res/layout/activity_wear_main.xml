<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_black">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingTop="14dp"
        android:paddingBottom="24dp"
        app:boxedEdges="left|right">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Title: App Name -->
            <TextView
                android:id="@+id/tvWearTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wear_title"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:letterSpacing="0.04"
                android:textStyle="bold" />

            <!-- Subtitle / Monitoring Status Badge -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_wear_status_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:text="@string/wear_status_monitoring"
                android:textColor="@color/wear_green_online"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <!-- Vitals Card: Pill Shape with PPG & SpO2 -->
            <LinearLayout
                android:id="@+id/layoutVitals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_wear_vitals"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvVitals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/wear_vitals_label"
                    android:textColor="@color/wear_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Touch SOS Button: Large Pill Shape for Emergency -->
            <Button
                android:id="@+id/btnManualSos"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_wear_btn_sos"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="🆘 BÁO ĐỘNG CẤP CỨU"
                android:textColor="@color/wear_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Discreet Open Test Lab Button (Hidden for Elderly, Accessible via 5-tap gesture on Title) -->
            <Button
                android:id="@+id/btnOpenTestLab"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_wear_btn_test_lab"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="🛠️ Kiểm Thử Tín Hiệu &amp; Mô Phỏng"
                android:textColor="#94A3B8"
                android:textSize="8sp"
                android:visibility="gone" />

            <!-- Diagnostic Status Log (Hidden from elderly main screen) -->
            <TextView
                android:id="@+id/tvLogResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/wear_status_ready"
                android:textColor="@color/wear_text_secondary"
                android:textSize="7.5sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
